{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "consumer-service": {
      "type": "application",
      "root": "apps/consumer-service",
      "entryFile": "main",
      "sourceRoot": "apps/consumer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/consumer-service/tsconfig.app.json",
        "assets": [
          {
            "include": "../../proto/**/*.proto",
            "watchAssets": true
          }
        ]
      }
    },
    "producer-service": {
      "type": "application",
      "root": "apps/producer-service",
      "entryFile": "main",
      "sourceRoot": "apps/producer-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/producer-service/tsconfig.app.json",
        "assets": [
          {
            "include": "../../proto/**/*.proto",
            "watchAssets": true
          }
        ]
      }
    }
  }
}